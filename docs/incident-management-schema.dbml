Project incident_management {
  database_type: 'PostgreSQL'
}

Enum role_name {
  ADMIN
  MANAGER
  HELPDESK
  ANALYST
  REPORTER
}

Enum incident_severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

Enum incident_status {
  NEW
  TRIAGE
  INVESTIGATING
  CONTAINED
  RECOVERED
  RESOLVED
  CLOSED
  REOPENED
}

Enum ioc_type {
  IPV4
  DOMAIN
  URL
  MD5_HASH
  SHA256_HASH
  EMAIL_ADDRESS
  FILE_PATH
}

Enum resolution_type {
  TRUE_POSITIVE
  FALSE_POSITIVE
  BENIGN
  NOT_APPLICABLE
}

Enum ioc_status {
  ACTIVE
  REMOVED
}

Enum sla_alert_type {
  ACK_WARNING
  ACK_BREACHED
  RESOLVE_WARNING
  RESOLVE_BREACHED
}

TableGroup incident_management {
  public.roles
  public.users
  public.user_roles
  public.incident_categories
  public.incidents
  public.incident_logs
  public.incident_attachments
  public.refresh_tokens
  public.security_audit_logs
  public.incident_iocs
  public.incident_tasks
  public.sla_alert_history
}

Table public.roles {
  id bigint [pk, increment]
  name varchar(30) [not null, unique]
  description varchar(255)
}

Table public.users {
  id bigint [pk, increment]
  username varchar(100) [not null, unique]
  password varchar(255) [not null]
  email varchar(150) [not null, unique]
  full_name varchar(150)
  department varchar(100)
  enabled boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  sla_warning_sent boolean [not null, default: false]
  failed_login_attempts int [not null, default: 0]
  account_locked_until timestamp
  token_version bigint [not null, default: 0]
  password_changed_at timestamp
}

Table public.user_roles {
  user_id bigint [not null]
  role_id bigint [not null]

  Indexes {
    (user_id, role_id) [pk]
  }
}

Table public.incident_categories {
  id bigint [pk, increment]
  name varchar(100) [not null, unique]
  description varchar(500)
  default_severity varchar(20)
}

Table public.incidents {
  id bigint [pk, increment]
  incident_code varchar(30) [not null, unique]
  title varchar(255) [not null]
  description text
  affected_system varchar(255)
  category_id bigint
  severity incident_severity [not null]
  status incident_status [not null, default: 'NEW']
  reported_by bigint
  assigned_to bigint
  detected_at timestamp
  sla_due_at timestamp
  ack_due_at timestamp
  acknowledged_at timestamp
  resolve_due_at timestamp
  resolution_type resolution_type
  closed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  sla_warning_sent boolean [not null, default: false]

  Indexes {
    status [name: 'idx_incidents_status']
    severity [name: 'idx_incidents_severity']
    assigned_to [name: 'idx_incidents_assigned_to']
    reported_by [name: 'idx_incidents_reported_by']
    ack_due_at [name: 'idx_incidents_ack_due_at']
    resolve_due_at [name: 'idx_incidents_resolve_due_at']
  }
}

Table public.incident_logs {
  id bigint [pk, increment]
  incident_id bigint [not null]
  performed_by bigint [not null]
  action_type varchar(50) [not null]
  old_value varchar(255)
  new_value varchar(255)
  note text
  record_hash varchar(128)
  created_at timestamp [not null, default: `now()`]

  Indexes {
    incident_id [name: 'idx_incident_logs_incident_id']
  }
}

Table public.incident_attachments {
  id bigint [pk, increment]
  incident_id bigint [not null]
  file_name varchar(255) [not null]
  storage_path varchar(500) [not null]
  content_type varchar(100)
  file_size bigint
  uploaded_by bigint
  uploaded_at timestamp [not null, default: `now()`]

  Indexes {
    incident_id [name: 'idx_incident_attachments_incident_id']
  }
}

Table public.refresh_tokens {
  id bigint [pk, increment]
  user_id bigint
  token varchar(255) [not null, unique]
  expiry_date timestamp [not null]
}

Table public.security_audit_logs {
  id bigint [pk, increment]
  username varchar(100)
  ip_address varchar(45)
  action varchar(100) [not null]
  details text
  created_at timestamp [not null, default: `now()`]
}

Table public.incident_iocs {
  id bigint [pk, increment]
  incident_id bigint [not null]
  type ioc_type [not null]
  value varchar(255) [not null]
  description text
  created_at timestamp [not null, default: `now()`]
  status ioc_status [not null, default: 'ACTIVE']
  removed_at timestamp
  removed_by bigint

  Indexes {
    incident_id [name: 'idx_incident_iocs_incident_id']
    type [name: 'idx_incident_iocs_type']
    value [name: 'idx_incident_iocs_value']
  }
}

Table public.incident_tasks {
  id bigint [pk, increment]
  incident_id bigint [not null]
  task_name varchar(255) [not null]
  is_completed boolean [not null, default: false]
  completed_at timestamp
  completed_by bigint

  Indexes {
    incident_id [name: 'idx_incident_tasks_incident_id']
    is_completed [name: 'idx_incident_tasks_is_completed']
  }
}

Table public.sla_alert_history {
  id bigint [pk, increment]
  incident_id bigint [not null]
  alert_type sla_alert_type [not null]
  recipient_scope varchar(30) [not null]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (incident_id, alert_type) [unique, name: 'uq_sla_alert_history_incident_type']
    incident_id [name: 'idx_sla_alert_history_incident']
  }
}

Ref: public.user_roles.user_id > public.users.id [delete: cascade]
Ref: public.user_roles.role_id > public.roles.id [delete: cascade]
Ref: public.incidents.category_id > public.incident_categories.id
Ref: public.incidents.reported_by > public.users.id
Ref: public.incidents.assigned_to > public.users.id
Ref: public.incident_logs.incident_id > public.incidents.id [delete: cascade]
Ref: public.incident_logs.performed_by > public.users.id
Ref: public.incident_attachments.incident_id > public.incidents.id [delete: cascade]
Ref: public.incident_attachments.uploaded_by > public.users.id
Ref: public.refresh_tokens.user_id > public.users.id [delete: cascade]
Ref: public.incident_iocs.incident_id > public.incidents.id [delete: cascade]
Ref: public.incident_iocs.removed_by > public.users.id
Ref: public.incident_tasks.incident_id > public.incidents.id [delete: cascade]
Ref: public.incident_tasks.completed_by > public.users.id [delete: set null]
Ref: public.sla_alert_history.incident_id > public.incidents.id [delete: cascade]

POSTGRES_PASSWORD=replace-with-a-strong-password
PGADMIN_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-random-256-bit-secret
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Chỉ publish các dịch vụ ra máy local. Đổi có chủ ý khi đặt sau reverse proxy.
POSTGRES_BIND_ADDRESS=127.0.0.1
PGADMIN_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1

# Admin bootstrap — bật để tự động enable admin lần đầu sau deploy.
# TẮT (hoặc xóa) sau khi login đầu tiên thành công.
# KHÔNG set trong production sau khi hệ thống đã vận hành.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Mẫu này dùng cho local HTTP. BẮt buộc đổi thành true khi triển khai HTTPS.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Strict

# SMTP tùy chọn. Khi bật, username/password là bắt buộc trong profile prod.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
